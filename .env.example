# ---------- Obligatorio ----------
# Contraseña de PostgreSQL. Genera una con:  openssl rand -base64 24
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-larga

# ---------- Opcional ----------
# Puerto en el host
APP_PORT=3002

# Registro de usuarios:
#   first  = solo se puede registrar el primer usuario (será administrador)  ← recomendado al empezar
#   open   = cualquiera que llegue a la web puede crear cuenta (útil mientras das de alta a tu familia)
#   closed = nadie puede registrarse
REGISTRATION=first

# Pon "true" cuando accedas por HTTPS (p. ej. a través de Nginx Proxy Manager).
# Con "true" el navegador NO enviará la cookie de sesión por http:// plano.
SECURE_COOKIES=false

# Duración de la sesión en días
SESSION_DAYS=30

# Buscador de direcciones (Photon / OpenStreetMap). Por defecto, el público de Komoot.
# GEOCODER_URL=http://IP_DE_TU_PHOTON:2322
# GEOCODER=off
# GEOCODER_BIAS=40.2,-3.7

# Zona horaria (hora de las copias de seguridad automáticas)
# TZ=Europe/Madrid

# Apps propias de Google / Microsoft para conectar Google Drive y OneDrive (opcional:
# Agendario trae las suyas; solo si quieres usar las tuyas, ver docs/registrar-apps.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
